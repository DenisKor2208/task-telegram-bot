# PostgreSQL
POSTGRES_DB=tgbot
POSTGRES_USER=tgbotadmin
POSTGRES_PASSWORD=password
POSTGRES_HOST_PORT=5432

# Redis
REDIS_HOST_PORT=6379
REDIS_PASSWORD=password

# Telegram — токен бота от @BotFather
TELEGRAM_TOKEN=XXX:XXX

# Правила:
#   - пароли — только латинские буквы и цифры (кроме символов @ : / # ? % и пробел).
DATABASE_URL=host=localhost port=${POSTGRES_HOST_PORT} dbname=${POSTGRES_DB} user=${POSTGRES_USER} password=${POSTGRES_PASSWORD} sslmode=disable
REDIS_CONNECTION_STRING=redis://:${REDIS_PASSWORD}@localhost:${REDIS_HOST_PORT}
